@{
    ViewData["Title"] = "Home";
}

<h2>Fridge</h2>


@if (TempData["RestockResult"] is string msg)
{
    <div class="alert alert-info">@msg</div>
}

<form asp-action="Restock" method="post">
    <button type="submit" class="btn btn-primary">Restock zero-quantity items</button>
</form>

<hr />

<a class="btn btn-outline-secondary" href="/Fridges">Go to fridges</a>
<a class="btn btn-outline-secondary" href="/Products">Products</a>
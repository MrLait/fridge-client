@model List<Fridge.Client.Api.Dtos.ProductDto>

<h2>Products</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Default quantity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.DefaultQuantity</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" href="/Products/Edit/@p.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-outline-secondary" href="/">Back</a>
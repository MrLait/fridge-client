@model Fridge.Client.Models.ViewModels.Products.EditProductVm

<h2>Edit product</h2>
<div id="imgMessage" class="alert d-none" role="alert"></div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="DefaultQuantity"></label>
        <input class="form-control" asp-for="DefaultQuantity" type="number" />
        <span class="text-danger" asp-validation-for="DefaultQuantity"></span>
    </div>

    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-outline-secondary" href="/Products">Cancel</a>
</form>
<hr />

<form id="uploadImageForm" enctype="multipart/form-data" asp-action="UploadImageAjax" method="post" id="UploadImage"
    data-success="Image uploaded successfully.">
    @Html.AntiForgeryToken()
    <input type="hidden" name="productId" value="@Model.Id" />

    <div class="mb-2">
        <label class="form-label">Upload image (jpg/png)</label>
        <input class="form-control" type="file" name="file" accept=".jpg,.jpeg,.png" />
    </div>

    <button class="btn btn-outline-primary" type="submit">Upload</button>
</form>

<div id="imagesContainer" class="mt-3">
    @await Html.PartialAsync("_ProductImages", Model)
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const msgEl = document.getElementById("imgMessage");

        function showMsg(text, type) {
            const el = document.getElementById("imgMessage");
            el.className = `alert alert-${type}`;
            el.textContent = text;
            el.classList.remove("d-none");
        }

        function hideMsg() {
            const el = document.getElementById("imgMessage");
            el.classList.add("d-none");
            el.textContent = "";
        }

        async function ajaxForm(form) {
            hideMsg();

            const resp = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (resp.status === 401) {
                showMsg("You must be logged in to manage images.", "warning");
                return;
            }

            if (!resp.ok) {
                const text = await resp.text();
                showMsg(text || "Upload failed.", "danger");
                return;
            }

            const html = await resp.text();
            document.getElementById("imagesContainer").innerHTML = html;

            wireImageHandlers();

            const msg = form.dataset.success ?? "Done.";
            showMsg(msg, "success");

            setTimeout(() => hideMsg(), 2500);
        }

        function wireImageHandlers() {
            document.querySelectorAll('#imagesContainer form.img-action-form')
                .forEach(f => f.addEventListener('submit', async e => {
                    e.preventDefault();
                    await ajaxForm(e.target);
                }));
        }

        document.getElementById('uploadImageForm')
            .addEventListener('submit', async e => {
                e.preventDefault();
                await ajaxForm(e.target);
            });

        wireImageHandlers();

    </script>
}
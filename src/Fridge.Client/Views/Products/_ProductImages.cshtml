@model Fridge.Client.Models.ViewModels.Products.EditProductVm

@{
    var primary = Model.Images.FirstOrDefault(x => x.IsPrimary);
}

<div class="mb-3">
    <h4>Images</h4>

    @if (primary is not null)
    {
        <div class="mb-2">
            <div class="text-muted">Primary</div>
            <img src="@primary.Url" style="max-height:160px;border:1px solid #ddd;padding:4px;" />
        </div>
    }

    @if (Model.Images.Count == 0)
    {
        <p class="text-muted">No images uploaded.</p>
    }
    else
    {
        <div class="row g-2">
            @foreach (var img in Model.Images)
            {
                <div class="col-md-3">
                    <div class="card">
                        <img class="card-img-top" src="@img.Url" style="object-fit:cover;height:140px;" />
                        <div class="card-body p-2">
                            <div class="small text-muted">@img.FileName</div>
                            <div class="d-flex gap-1 mt-2">
                                @if (!img.IsPrimary)
                                {
                                    <form class="img-action-form" asp-action="SetPrimaryImageAjax" method="post"
                                        id="SetPrimaryImage" data-success="Primary image updated.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@Model.Id" />
                                        <input type="hidden" name="imageId" value="@img.Id" />
                                        <button class="btn btn-sm btn-outline-primary" type="submit">Primary</button>
                                    </form>
                                }
                                <form class="img-action-form" asp-action="DeleteImageAjax" method="post" id="DeleteImage"
                                    data-success="Image deleted.">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
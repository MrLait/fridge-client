@model Fridge.Client.Models.FridgeProductsVm

<h2>Products in fridge</h2>

<h4>Add product</h4>
<div id="actionMessage" class="alert d-none" role="alert"></div>

<form id="addForm" asp-action="AddProductAjax" method="post" class="row g-2">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="FridgeId" value="@Model.FridgeId" />

    <div class="col-md-6">
        <select name="ProductId" class="form-select">
            <option value="">-- select product --</option>
            @foreach (var p in Model.Products)
            {
                <option value="@p.Value">@p.Text</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <input class="form-control" name="Quantity" type="number" min="1" value="1" />
    </div>

    <div class="col-md-3">
        <button class="btn btn-primary w-100" type="submit">Add</button>
    </div>
</form>

<div id="itemsContainer">
    @await Html.PartialAsync("_FridgeProductsTable", Model.Items, new ViewDataDictionary(ViewData)
    {
    ["FridgeId"] = Model.FridgeId
        })
</div>
<hr />

<a class="btn btn-outline-secondary" href="/Fridges">Back</a>

@section Scripts {
    <script>
        const msgEl = document.getElementById("actionMessage");
        function showMessage(text, type) {
            msgEl.className = `alert alert-${type}`;
            msgEl.textContent = text;
            msgEl.classList.remove("d-none");
        }

        function hideMessage() {
            msgEl.classList.add("d-none");
            msgEl.textContent = "";
        }

        async function handleAjaxFormSubmit(form, containerId) {
            const resp = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (resp.status === 401) {
                showMessage("You must be logged in to perform this action. Go to Login page.", "warning");
                return;
            }

            if (!resp.ok) {
                const text = await resp.text();
                showMessage(text || "Request failed.", "danger");
                return;
            }

            const html = await resp.text();
            document.getElementById(containerId).innerHTML = html;
            showMessage("Done.", "success");

            wireDeleteHandlers();
        }

        // ADD product
        document.getElementById('addForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            await handleAjaxFormSubmit(e.target, "itemsContainer");
            e.target.querySelector('input[name="Quantity"]').value = 1;
        });

        // DELETE product handlers
        function wireDeleteHandlers() {
            document.querySelectorAll('#itemsContainer form.delete-item-form')
                .forEach(f => {
                    f.addEventListener('submit', async function (e) {
                        e.preventDefault();
                        await handleAjaxFormSubmit(e.target, "itemsContainer");
                    });
                });
        }

        wireDeleteHandlers();
    </script>
}
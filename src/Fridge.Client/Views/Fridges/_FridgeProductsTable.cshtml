@model List<Fridge.Client.Api.Dtos.FridgeProductDto>

@{
    var fridgeId = (Guid)ViewData["FridgeId"]!;
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Default</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.ProductName</td>
                <td>@x.Quantity</td>
                <td>@x.ProductDefaultQuantity</td>
                <td>
                    <form class="delete-item-form" asp-action="DeleteProductAjax" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="fridgeId" value="@fridgeId" />
                        <input type="hidden" name="fridgeProductId" value="@x.Id" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
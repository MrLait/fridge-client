@model Fridge.Client.Models.FridgeFormVm
<h2>Create fridge</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="OwnerName"></label>
        <input class="form-control" asp-for="OwnerName" />
        <span class="text-danger" asp-validation-for="OwnerName"></span>
    </div>


    <div class="mb-3">
        <label class="form-label" asp-for="ModelId"></label>
        <select class="form-select" asp-for="ModelId" asp-items="Model.Models">
            <option value="">Select fridge model</option>
        </select>
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <button class="btn btn-primary" type="submit">Create</button>
    <a class="btn btn-outline-secondary" href="/Fridges">Cancel</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

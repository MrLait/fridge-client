{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fridge.Client: Debug",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Fridge.Client/bin/Debug/net8.0/Fridge.Client.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Fridge.Client",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Fridge.Client: Run without build",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "",
      "program": "${workspaceFolder}/src/Fridge.Client/bin/Debug/net8.0/Fridge.Client.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Fridge.Client",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    }
  ]
}